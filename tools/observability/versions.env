# Every binary the observability stack runs, pinned by version and digest. Read from the registries and
# dl.grafana.com on 2026-11-28 (verified 2026-11-28); never `latest`. Sourced by run.sh and the workflows.
# An image is named by its tag AND the digest of its multi-platform index; fetch.py checks every layer's sha256.
OTELCOL_REPO=otel/opentelemetry-collector-contrib
OTELCOL_TAG=0.142.0
OTELCOL_DIGEST=sha256:38c349c3b7a2fd7ea46700cde8fa13d35b699ef2ce245bdf34dae2a413512f76
PROMETHEUS_REPO=prom/prometheus
PROMETHEUS_TAG=v3.16.0
PROMETHEUS_DIGEST=sha256:e04987641b57704f408e31f6373ba4138ecf27cb4a165d24aabb6c38fddd0f06
GRAFANA_VERSION=13.3.1
GRAFANA_SHA256=6acf8939dd2f73332cbcafc27a33973fb1115b8867e7ffa3223c6e2ecbed8531
# Alertmanager: the multi-platform index of v0.35.1 (the newest v0.x tag of Docker Hub's prom/alertmanager), read on
# 2026-11-28 (verified 2026-11-28); the binary is /bin/alertmanager in the image.
ALERTMANAGER_REPO=prom/alertmanager
ALERTMANAGER_TAG=v0.35.1
ALERTMANAGER_DIGEST=sha256:4e3d029e69c7f61dd53a2b31a3dc427a2b81736cffca185c0854075e07969e36
